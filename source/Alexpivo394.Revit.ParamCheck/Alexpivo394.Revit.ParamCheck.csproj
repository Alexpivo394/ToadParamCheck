<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <!-- Fallback Revit version for design-time evaluation; a Debug.Rxx / Release.Rxx build overrides it -->
    <PropertyGroup>
        <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Configurations>Debug.R20;Debug.R21;Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R20;Release.R21;Release.R22;Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
        <IsPackable>true</IsPackable>
        <!-- RevitContext.BeginDialogSuppressionScope ссылается на MessageBoxResult из WPF -->
        <UseWPF>true</UseWPF>
        <PackageId>Alexpivo394.Revit.ParamCheck</PackageId>
        <Description>UI-free Revit parameter fill (LOI) check: detached opening, rule-based element selection, Excel reports and dashboard history, Revit category and parameter catalog.</Description>
        <PackageTags>revit;autodesk;loi;bim;parameters</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Nice3point.Revit.Toolkit"/>
        <PackageReference Include="Nice3point.Revit.Extensions"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI"/>
        <PackageReference Include="EPPlus"/>
        <PackageReference Include="Newtonsoft.Json"/>
    </ItemGroup>

    <!-- Пакет профилей в зависимостях — версии без года: сборка передаёт её в ProfilesVersion (см. проект профилей) -->
    <ItemGroup>
        <ProjectReference Include="..\Alexpivo394.Revit.ParamCheck.Profiles\Alexpivo394.Revit.ParamCheck.Profiles.csproj"
                          GlobalPropertiesToRemove="RevitVersion"
                          AdditionalProperties="Configuration=$(Configuration.Split('.')[0])"/>
    </ItemGroup>

</Project>
