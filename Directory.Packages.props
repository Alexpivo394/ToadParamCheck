<Project>

    <!-- Global NuGet configuration -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <!-- Revit Dependencies -->
    <ItemGroup>
        <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*-*" Condition="$(RevitVersion) != ''"/>
        <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*-*" Condition="$(RevitVersion) != ''"/>

        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2020.4.5" Condition="$(RevitVersion) == '2020'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2021.4.5" Condition="$(RevitVersion) == '2021'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2022.4.5" Condition="$(RevitVersion) == '2022'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2023.4.5" Condition="$(RevitVersion) == '2023'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2024.3.5" Condition="$(RevitVersion) == '2024'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2025.2.5" Condition="$(RevitVersion) == '2025'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2026.1.5" Condition="$(RevitVersion) == '2026'"/>
        <PackageVersion Include="Nice3point.Revit.Toolkit" Version="2027.0.5" Condition="$(RevitVersion) == '2027'"/>

        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2020.5.6" Condition="$(RevitVersion) == '2020'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2021.5.6" Condition="$(RevitVersion) == '2021'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2022.5.6" Condition="$(RevitVersion) == '2022'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2023.5.6" Condition="$(RevitVersion) == '2023'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2024.3.6" Condition="$(RevitVersion) == '2024'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2025.2.6" Condition="$(RevitVersion) == '2025'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2026.1.6" Condition="$(RevitVersion) == '2026'"/>
        <PackageVersion Include="Nice3point.Revit.Extensions" Version="2027.0.6" Condition="$(RevitVersion) == '2027'"/>
    </ItemGroup>

    <!-- Core Dependencies -->
    <ItemGroup>
        <!-- Только для netstandard2.0: на .NET входит в рантайм -->
        <PackageVersion Include="System.Text.Json" Version="10.0.15"/>
        <PackageVersion Include="ClosedXML" Version="0.105.1"/>
        <!-- Только тестам: отпечаток профиля сверяется с тем, что давал Newtonsoft.Json -->
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4"/>

        <!-- Testing -->
        <PackageVersion Include="Shouldly" Version="4.3.0"/>
        <PackageVersion Include="TUnit" Version="1.87.12"/>

        <!-- Build Automation -->
        <PackageVersion Include="Sourcy.DotNet" Version="1.1.1"/>
        <PackageVersion Include="ModularPipelines" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.Git" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.GitHub" Version="3.2.8"/>
        <PackageVersion Include="ModularPipelines.DotNet" Version="3.2.8"/>
        <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52"/>
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
    </ItemGroup>

    <!-- Development Dependencies -->
    <ItemGroup>
        <GlobalPackageReference Include="Polyfill" Version="12.0.0"/>
    </ItemGroup>

</Project>
